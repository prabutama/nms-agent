{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/AI_CONTEXT.md",
    "docs/PRD.md"
  ],
  "lsp": true,
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "bin/**",
      "dist/**",
      "tmp/**",
      "vendor/**",
      "*.db",
      "*.log"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
   "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ],
      "enabled": true
    }
  },
  "model": "lmstudio-dgx/qwen/qwen3.6-35b-a3b",
  "small_model": "lmstudio-dgx/qwen/qwen3.6-35b-a3b",

  "provider": {
    "lmstudio-dgx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio DGX",
      "options": {
        "baseURL": "http://10.10.10.34:1234/v1",
        "apiKey": "lm-studio"
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B on DGX",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    }
  }
}